# Environment Variables Template

# Privy Configuration
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# Solana Configuration
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Arcium Configuration
NEXT_PUBLIC_ARCIUM_NETWORK=devnet

# Arcium Simulation Mode
# Set to 'true' for demo (uses local encryption - no deployment required)
# Set to 'false' for production (requires deployed MXE program in WSL2/Linux)
NEXT_PUBLIC_ARCIUM_SIMULATION_MODE=true

# Arcium Program IDs (required when SIMULATION_MODE=false)
# Deploy using: arcium deploy --cluster-offset 0 --recovery-set-size 3
# NEXT_PUBLIC_ARCFUND_PROGRAM_ID=your-deployed-program-id
# NEXT_PUBLIC_ARCIUM_PROGRAM_ID=arc1umE2cLaXZLt24JGLKvxPzNSrtEzHVB8wVSTPzBi2
# NEXT_PUBLIC_ARCIUM_CLUSTER_OFFSET=0
